# Copy this file to .env and fill in the values. Never commit .env.

# Speech to text for the body, and image generation (OpenAI)
OPENAI_API_KEY=

# Chat / conversation (DeepSeek, OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Text-to-speech (Fish Audio)
FISH_AUDIO_API_KEY=

# Optional settings. Leave these alone unless you want to change something.
# DEEPSEEK_MODEL=deepseek-v4-flash
# FISH_AUDIO_VOICE_ID=      # a voice ID from fish.audio (open a voice and copy the ID from its address)
# FISH_AUDIO_MODEL=         # empty = the server tries s2.1-pro, s2-pro and s1 and remembers the one that works
# ARTEMIS_PORT=8000

# Artemis's body (python -m body). Leave these alone unless you want to change something.
# ARTEMIS_STT_ORDER=openai,local       # speech to text: the cloud first, then on this computer (needs faster-whisper)
# ARTEMIS_WAKE_MODEL=hey_jarvis        # the wake word; "push" = press Enter instead. "Hey Artemis" comes later
# ARTEMIS_INPUT_DEVICE=                # part of the microphone's name; empty = the default one
# ARTEMIS_OUTPUT_DEVICE=               # part of the speaker's name
# ARTEMIS_BARGE_IN=false               # talk over Artemis to interrupt: only with echo cancelling (headphones or the mic array)

# Copy this file to .env and fill in the values. Never commit .env.

# Image generation (OpenAI)
OPENAI_API_KEY=

# Chat / conversation (DeepSeek, OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Text-to-speech (Fish Audio)
FISH_AUDIO_API_KEY=

# Optional settings. Leave these alone unless you want to change something.
# DEEPSEEK_MODEL=deepseek-v4-flash
# FISH_AUDIO_VOICE_ID=      # a voice ID from fish.audio (open a voice and copy the ID from its address)
# FISH_AUDIO_MODEL=         # empty = the server tries s2.1-pro, s2-pro and s1 and remembers the one that works
# MILO_PORT=8000
